<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The sign-in session can only be opened on the phone that made it, and notebooks come back
     from the student's own cloud save after sign-in, so neither is put in device backups. -->
<full-backup-content>
    <exclude domain="file" path="datastore/zing_session.preferences_pb" />
    <exclude domain="database" path="zing.db" />
    <exclude domain="database" path="zing.db-shm" />
    <exclude domain="database" path="zing.db-wal" />
</full-backup-content>
